{
  "name": "credential-service",
  "version": "0.1.0",
  "description": "Local dev stub of the credential storage service consumed by ap-executor (CREDENTIAL_STORAGE_TYPE=db_encrypted). NEVER DEPLOY THIS.",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start:dev": "nodemon",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --passWithNoTests --coverage --ci --maxWorkers=2",
    "test:local": "jest --passWithNoTests --coverage --maxWorkers=2",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "11.0.15",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.0.15",
    "@nestjs/platform-express": "11.0.15",
    "async-mutex": "0.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/testing": "11.1.13",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.33",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "29.7.0",
    "nodemon": "3.0.2",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3",
    "typescript-eslint": "8.56.0"
  }
}
